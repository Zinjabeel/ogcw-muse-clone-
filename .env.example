# OGCW: the settings the site reads from its environment.
# Copy this file to .env.local on your computer, or enter each name and its
# value in Vercel (Project → Settings → Environment Variables).
# Never put real values in this file: it is committed to GitHub.

# --- Private (server only, never sent to a browser) -------------------------

# The Sanity key the server uses to save site-editor changes, keep login
# limits and save design notes. Make one in Sanity: sanity.io/manage →
# project z0ih0mun → API → Tokens → Add API token, permission "Editor".
# Without it the site still works, but admins can only save site edits while
# logged in to the studio with GitHub, and login limits are counted per server.
SANITY_EDITOR_TOKEN=

# The email addresses with admin access (they also need two-step login),
# separated by commas. Not a secret, but kept out of the code.
OGCW_ADMIN_EMAILS=you@example.com

# --- Public (built into the site; safe for browsers) ------------------------

# Cloudflare Turnstile "are you human" check on sign-up and login. Optional:
# leave empty to keep it off. Site key from dash.cloudflare.com → Turnstile.
# Its secret key goes in Supabase (Authentication → Attack Protection), not here.
VITE_TURNSTILE_SITE_KEY=

# --- Not needed ----------------------------------------------------------------
# The Supabase address and its publishable key, and the Sanity project id and
# dataset, are public by design and live in the code (src/lib/supabase.ts,
# src/sanity/env.ts). OGCW_ADMIN_PASSWORD from older setups is no longer used.
